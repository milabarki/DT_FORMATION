[Indicateur_Compte:'Indicateur_Compte':'Mapping',Hierarchie_FIN:'Hierarchie_FIN':'Hierarchie01'] = S: if(SUBST( !Compte, 1,1)@<'6','NA_CRF',STET);
[Indicateur_Compte:'Indicateur_Compte':'Mapping',Hierarchie_FIN:'Hierarchie_FIN':'Hierarchie02'] = S: if(SUBST( !Compte, 1,1)@<'6','NA_CRP_PA',STET);


[Indicateur_Compte:'Indicateur_Compte':'Mapping'] = Stet;

[Indicateur_Compte:'Indicateur_Compte':'Libelle'] = S:
  
  subst(attrs('Compte',  db('Fin_Param_Compte', !Compte,!Hierarchie_FIN,'Mapping'),'Code-Libelle'),
        long(db('Fin_Param_Compte', !Compte,!Hierarchie_FIN,'Mapping'))+2
        ,500);



# ['Hierarchie_FIN':'Hierarchie_FIN':'Hierarchie02','Pond'] = N: if(SUBST( !Compte, 1,5)@='79162',1,CONTINUE);
# ['Hierarchie_FIN':'Hierarchie_FIN':'Hierarchie02','Pond'] = N: if(SUBST( !Compte, 1,4)@='6419',1,CONTINUE);

# ['Hierarchie_FIN':'Hierarchie_FIN':'Hierarchie03','Pond'] = N: if(SUBST( !Compte, 1,2)@='28',1,CONTINUE);




# ['Pond'] = N: if(SUBST( !Compte, 1,1)@='6',-1,CONTINUE);
# ['Pond'] = N: if(SUBST( !Compte, 1,3)@='791',-1,CONTINUE);

# ['Pond'] = N:1;




[] = S:   
attrs('Compte', db('Fin_Param_Compte', !Compte,!Hierarchie_FIN,'Mapping'),!Indicateur_Compte | '_' | Attrs('Hierarchie_FIn',!Hierarchie_FIn,'Nom'));

  

