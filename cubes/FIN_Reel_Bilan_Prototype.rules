#SKIPCHECK;


['Indicateur':'Indicateur':'M'] =N:DB('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, !Z_Tmp_Hierarchie_FIN,!Indicateur );


['Indicateur':'Indicateur':'S'] =N:DB('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, !Z_Tmp_Hierarchie_FIN,!Indicateur );



# Compte de Bilan 


 ['Indicateur':'Indicateur':'S'] = 
   if(DIMIX( 'Z_Tmp_Hierarchie_FIN',!Z_Tmp_Hierarchie_FIN | '_C')<>0 % DIMIX( 'Z_Tmp_Hierarchie_FIN',!Z_Tmp_Hierarchie_FIN | '_D')<>0 ,  
                                                                     0 

   ,ConsolidateChildren('Z_Tmp_Hierarchie_FIN'));


['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Z_Tmp_Hierarchie_FIN, long(!Z_Tmp_Hierarchie_FIN)-1,2 ) @= '_D',  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Z_Tmp_Hierarchie_FIN, 1,long(!Z_Tmp_Hierarchie_FIN)-2), 'M' )>0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Z_Tmp_Hierarchie_FIN, 1,long(!Z_Tmp_Hierarchie_FIN)-2), 'M' ),0 )
  
  ,CONTINUE);

['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Z_Tmp_Hierarchie_FIN, long(!Z_Tmp_Hierarchie_FIN)-1,2 ) @= '_C',  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Z_Tmp_Hierarchie_FIN, 1,long(!Z_Tmp_Hierarchie_FIN)-2), 'M' )<0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Z_Tmp_Hierarchie_FIN, 1,long(!Z_Tmp_Hierarchie_FIN)-2), 'M' )*-1,0 )
  
  ,CONTINUE);



['Indicateur':'Indicateur':'S'] = 
db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit,  !Z_Tmp_Hierarchie_FIN, 'M' );
 