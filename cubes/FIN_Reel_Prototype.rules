SKIPCHECK;

########### S
['Indicateur':'Indicateur':'S'] = 
  if((DIMIX( 'Compte',!Compte | '_C')<>0 % DIMIX( 'Compte',!Compte | '_D')<>0) & ELLEV( 'Compte',  !Compte)=1 ,  
                                                                    0 ,
CONTINUE);

['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Compte, long(!Compte)-1,2 ) @= '_D' & ELLEV( 'Compte', SUBST( !Compte, 1,long(!Compte)-2))=1,  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' )<0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' ),0 )
  
  ,CONTINUE);

['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Compte, long(!Compte)-1,2 ) @= '_C' & ELLEV( 'Compte', SUBST( !Compte, 1,long(!Compte)-2) )=1,  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' )>0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' ),0 )
  
  ,CONTINUE);

['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Compte, long(!Compte)-1,2 ) @= '_D' ,  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' )<0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' ),0 )
  
  ,CONTINUE);

['Indicateur':'Indicateur':'S'] = 
  if(SUBST( !Compte, long(!Compte)-1,2 ) @= '_C' ,  
                                                                    if(db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' )>0,db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, SUBST( !Compte, 1,long(!Compte)-2), 'M' ),0 )
  
  ,CONTINUE);


['Indicateur':'Indicateur':'S'] = N:
db('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit,  !Compte, 'M' );

['Indicateur':'Indicateur':'S'] = C:
ConsolidateChildren('Compte');


############## FIN S1




####"TVA Exemple sur Centre Profit C509

 ['C509','CRF_170',Version:'Version':'R_AJU_CALC','M'] = N: ['CRF_320',Version:'Version':'R_SAP'] * 0.055;
 ['C509',Version:'Version':'R_AJU_CALC','M'] = N:if(ELISANC( 'Compte', 'CRF_320',!Compte ) = 1,[Version:'Version':'R_SAP']* 0.055,STET);




###### Cumule

['C'] = if(ELLEV( 'Periode', !Periode )=1, db('FIN_Reel_Prototype', !Version, !Periode | '.12', !Centre_Profit, !Compte, !Indicateur ),CONTINUE);
['G03'] = if(ELLEV( 'Periode', !Periode )=1, db('FIN_Reel_Prototype', !Version, !Periode | '.12', !Centre_Profit, !Compte, !Indicateur ),CONTINUE);
['G06'] = if(ELLEV( 'Periode', !Periode )=1, db('FIN_Reel_Prototype', !Version, !Periode | '.12', !Centre_Profit, !Compte, !Indicateur ),CONTINUE);
['G12'] = if(ELLEV( 'Periode', !Periode )=1, db('FIN_Reel_Prototype', !Version, !Periode | '.12', !Centre_Profit, !Compte, !Indicateur ),CONTINUE);
['G18'] = if(ELLEV( 'Periode', !Periode )=1, db('FIN_Reel_Prototype', !Version, !Periode | '.12', !Centre_Profit, !Compte, !Indicateur ),CONTINUE);








  FEEDERS;


 ['C509','CRF_320',Version:'Version':'R_SAP']=>['CRF_170',Version:'Version':'R_AJU_CALC'];
 ['C509','CRF_320',Version:'Version':'R_SAP']=>['CRF_320',Version:'Version':'R_AJU_CALC'];

['Indicateur':'Indicateur':'M'] => dB('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, !Compte , 'S' );

['Indicateur':'Indicateur':'M'] => dB('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, !Compte | '_D', 'S' );
['Indicateur':'Indicateur':'M'] => dB('FIN_Reel_Prototype', !Version, !Periode, !Centre_Profit, !Compte | '_C', 'S' );


