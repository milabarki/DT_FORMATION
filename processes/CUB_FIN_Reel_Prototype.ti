#region Prolog


CubeClearData( 'FIN_Reel_Prototype' );
DimensionDeleteAllElements( 'Compte' );

 DimensionSortOrder( 'Compte','ByName','Ascending','ByHierarchy','Ascending' );


#endregion
#region Metadata


DimensionElementInsert( 'Centre_Profit', '', 'Total_Centre_Profit', 'N' );

if(CP@<>'');
DimensionElementInsert( 'Centre_Profit', '', CP, 'N' );
DimensionElementComponentAdd( 'Centre_Profit', 'Total_Centre_Profit', CP, 1 );

else;
DimensionElementInsert( 'Centre_Profit', '', 'Pas_de_Centre_Profit', 'N' );
DimensionElementComponentAdd( 'Centre_Profit', 'Total_Centre_Profit', 'Pas_de_Centre_Profit', 1 );
endif;

if(Compte@<>'');
    DimensionElementInsert( 'Compte', '', Compte, 'N' );
    DimensionElementInsert( 'Compte', '', 'Bilan', 'N' );
    DimensionElementInsert( 'Compte', '', 'CR', 'N' );
    DimensionElementInsert( 'Compte', '', 'Budget', 'N' );
    DimensionElementInsert( 'Compte', '', 'Total_Compte', 'N' );

    DimensionElementComponentAdd( 'Compte', 'Total_Compte', 'Bilan', 1 );
    DimensionElementComponentAdd( 'Compte', 'Total_Compte', 'CR', 1 );
    DimensionElementComponentAdd( 'Compte', 'Total_Compte', 'Budget', 1 );
    

if(subst(Compte,1,1)@<'6');
    vConso = 'Bilan';
elseif(subst(Compte,1,1)@>'7');
    vConso = 'Budget';
else;
    vConso = 'CR';
endif;


DimensionElementComponentAdd( 'Compte', vConso, Compte, 1 );



else;
DimensionElementInsert( 'Compte', '', 'Pas_de_Compte', 'N' );
DimensionElementComponentAdd( 'Compte', 'Total_Compte', 'Pas_de_Compte', 1 );
endif;





#endregion
#region Data


# vAnnee = SUBST( Periode, 7,4);
# vMois = subst(Periode,4,2);
# vAnneeCumul = vAnnee;
# vPeriode =   vAnnee |'.' |vMois ;
vPeriode = Periode;


if(CP@='');
    CP='Pas_de_Centre_Proft';
endif;

if(Compte@='');
    Compte='Pas_de_Compte';
endif;



CellIncrementN( m*-1,'FIN_Reel_Prototype', 'R_SAP', VPeriode, CP, Compte, 'M' );

AttrPuts('X','Compte','Total_Compte','Do_Not_Delete');
AttrPutS('X','Compte','Bilan','Do_Not_Delete');
AttrPutS('X','Compte','CR','Do_Not_Delete');
AttrPutS('X','Compte',Compte,'Check_Compte');



#endregion
#region Epilog

#ExecuteProcess( 'CUB_FIN_Reel_Prototype_Cumul' );

#endregion