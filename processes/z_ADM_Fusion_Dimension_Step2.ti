#region Prolog

vCubeSource = 'FIN_Param_Compte';
vDim = 'Compte';

vViewSource = GetProcessName() |  '_Source';

ViewCreate( vCubeSource, vViewSource, 1 );


vSubSetName = vViewSource;

vDim = 'Compte';

SubsetCreate( vDim, vSubSetName, 1 );
vMdx = 'FILTER({ORDER(TM1FILTERBYLEVEL(TM1SUBSETALL([Compte].[Compte]) , 0) , [Compte].[Compte].CURRENTMEMBER.PROPERTIES("MEMBER_NAME") , BASC)}, (INSTR(1, [Compte].[Compte].CURRENTMEMBER.PROPERTIES("Check_Compte"), "X", 1) >= 1))';
SubsetMDXSet( vDim, vSubSetName, vMdx );


ViewSubsetAssign( vCubeSource, vViewSource, vDim, vSubSetName );


vDim = 'Indicateur_Compte';

SubsetCreate( vDim, vSubSetName, 1 );
SubsetElementInsert( vDim, vSubSetName, 'MAPPING', 0 );

ViewSubsetAssign( vCubeSource, vViewSource, vDim, vSubSetName );


ViewExtractSkipCalcsSet( vCubeSource , vViewSource , 1 ) ;
ViewExtractSkipRuleValuesSet( vCubeSource , vViewSource , 0 ) ;
ViewExtractSkipZeroesSet( vCubeSource , vViewSource , 0 ) ;

DatasourceNameForServer = vCubeSource ;
DatasourceCubeview = vViewSource ;



#endregion
#region Metadata

if(Attrs('Hierarchie_FIN',vHierarchie,'Nom') @= '');
    ItemSkip;
endif;


vDim = 'Compte';

DimensionElementInsert( vDim, '', 'Bilan', 'N' );
DimensionElementInsert( vDim, '', 'CR', 'N' );



vConso = 'Total_Compte';
DimensionElementInsert( vDim, '', vConso, 'N' );
DimensionElementComponentAdd( vDim, vConso, 'Bilan', 1 );
DimensionElementComponentAdd( vDim, vConso, 'CR', 1 );


if(Attrs('Compte',vElement,'Check_Compte')@='X');

if(subst(vElement,1,1)@<'6');
    vConso = 'Bilan';
else;
    vConso = 'CR';
endif;

DimensionElementComponentAdd( vDim, vConso, vElement, 1 );
endif;



if(vValeur @='');
DimensionElementInsert( vDim, '', vHierarchie |'_A_Affecter' , 'N' );
DimensionElementInsert( vDim, '', vHierarchie , 'N' );   
DimensionElementComponentAdd( vDim, vHierarchie |'_A_Affecter', vElement, 1 );
DimensionElementComponentAdd( vDim, vHierarchie,vHierarchie |'_A_Affecter',1 );
    

elseif(subst(vValeur,1,3)  @='NA_');
DimensionElementInsert( vDim, '', vHierarchie |'_Check' , 'N' );
DimensionElementComponentAdd( vDim, vHierarchie |'_Check', vValeur, 1 );
DimensionElementComponentAdd( vDim, vHierarchie,vHierarchie |'_Check', 1 );


endif;



if(vValeur@<>'');
                    vPond = CellGetN( vCubeSource, vElement,vHierarchie, 'Pond'  );
#ASCIIOutput( 'zzFusion.txt', vElement,vIndicateur,vValeur , NumberToString( vPond ));

                    DimensionElementInsert( vDim, '', vValeur, 'N' );
                    DimensionElementComponentAdd( vDim, vValeur, vElement, vPond );

endif;


#endregion