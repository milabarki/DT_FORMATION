AttrPutS(vLib2,vDim, vNiveau2, 'Lib' | '_' | vHierarchyName );

AttrPutS(vCodeLib2,vDim, vNiveau2, 'Code-Libelle' );
AttrPutS(vLib2 | ' (' | vHierarchyName | ')',vDim, vNiveau2, 'Libelle' | '_' | vHierarchyName );
