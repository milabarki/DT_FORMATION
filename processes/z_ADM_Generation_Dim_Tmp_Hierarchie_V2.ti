IF (vNiveau10 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau10,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau10,VPOND10);   
      vParent = vNiveau10;
endif;
endif;


#endregion
#region Data


vHierarchyName = ATTRS( vDimHierarchy, Hierarchie,'Nom' );

AttrPutS(vHierarchyName |'.',vDim, Hierarchie, 'Lib' | '_' | vHierarchyName );
 
AttrPutS(vHierarchyName |'.',vDim, Hierarchie, 'Code-Libelle' );
AttrPutS(vHierarchyName |'.',vDim, Hierarchie, 'Libelle' | '_' | vHierarchyName );


vNiveau0 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N00' );
vNiveau1 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N01' );
vNiveau2 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N02' );
vNiveau3 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N03' );
vNiveau4 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N04' );
vNiveau5 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N05' );
vNiveau6 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N06' );
vNiveau7 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N07' );
vNiveau8 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N08' );
vNiveau9 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N09' );
vNiveau10 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N10' );

vLib0 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N00' );
vLib1 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N01' );
vLib2 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N02' );
vLib3 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N03' );
vLib4 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N04' );
vLib5 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N05' );
vLib6 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N06' );
vLib7 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N07' );
vLib8 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N08' );
vLib9 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N09' );
vLib10 = CellGetS( vCubeSource,Hierarchie,Item,'LIB_N10' );

vCodeLib0 = vNiveau0 | '-' | vLib0;
vCodeLib1 = vNiveau1 | '-' | vLib1;
vCodeLib2 = vNiveau2 | '-' | vLib2;
vCodeLib3 = vNiveau3 | '-' | vLib3;
vCodeLib4 = vNiveau4 | '-' | vLib4;
vCodeLib5 = vNiveau5 | '-' | vLib5;
vCodeLib6 = vNiveau6 | '-' | vLib6;
vCodeLib7 = vNiveau7 | '-' | vLib7;
vCodeLib8 = vNiveau8 | '-' | vLib8;
vCodeLib9 = vNiveau9 | '-' | vLib9;
vCodeLib10 = vNiveau10 | '-' | vLib10; 

# On stocke les niveaux dans les attributs
if(Dimix(vDim,Value)<>0);
        AttrPutS(vLib0,vDim,Value,'N00' | '_' | vHierarchyName);
        AttrPutS(vLib1,vDim,Value,'N01' | '_' | vHierarchyName);
        AttrPutS(vLib2,vDim,Value,'N02' | '_' | vHierarchyName);
        AttrPutS(vLib3,vDim,Value,'N03' | '_' | vHierarchyName);
        AttrPutS(vLib4,vDim,Value,'N04' | '_' | vHierarchyName);
        AttrPutS(vLib5,vDim,Value,'N05' | '_' | vHierarchyName);
        AttrPutS(vLib6,vDim,Value,'N06' | '_' | vHierarchyName);
        AttrPutS(vLib7,vDim,Value,'N07' | '_' | vHierarchyName);
        AttrPutS(vLib8,vDim,Value,'N08' | '_' | vHierarchyName);
        AttrPutS(vLib9,vDim,Value,'N09' | '_' | vHierarchyName);
         AttrPutS(vLib10,vDim,Value,'N10' | '_' | vHierarchyName);
   
endif;


IF (vNiveau0 @<>'');
AttrPutS(vLib0,vDim, vNiveau0, 'Lib' | '_' | vHierarchyName );
 
AttrPutS(vCodeLib0,vDim, vNiveau0, 'Code-Libelle' );
AttrPutS(vLib0 | ' (' | vHierarchyName | ')',vDim, vNiveau0, 'Libelle' | '_' | vHierarchyName );
endif;

