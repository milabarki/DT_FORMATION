    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau6,VPOND6);   
      vParent = vNiveau6;
endif;
endif;

IF (vNiveau7 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau7,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau7,VPOND7);   
      vParent = vNiveau7;
endif;
endif;

IF (vNiveau8 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau8,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau8,VPOND8);   
      vParent = vNiveau8;
endif;
endif;

IF (vNiveau9 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau9,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau9,VPOND9);   
