AttrPutS(vLib3 | ' (' | vHierarchyName | ')',vDim, vNiveau3, 'Libelle' | '_' | vHierarchyName );
endif;

IF (vNiveau4 @<>'');
AttrPutS(vLib4,vDim, vNiveau4, 'Lib' | '_' | vHierarchyName);

AttrPutS(vCodeLib4,vDim, vNiveau4, 'Code-Libelle' );
AttrPutS(vLib4 | ' (' | vHierarchyName | ')',vDim, vNiveau4, 'Libelle' | '_' | vHierarchyName );
endif;

IF (vNiveau5 @<>'');
AttrPutS(vLib5,vDim, vNiveau5, 'Lib' | '_' | vHierarchyName );

AttrPutS(vCodeLib5,vDim, vNiveau5, 'Code-Libelle' );
AttrPutS(vLib5 | ' (' | vHierarchyName | ')',vDim, vNiveau5, 'Libelle' | '_' | vHierarchyName );

endif;

IF (vNiveau6 @<>'');
AttrPutS(vLib6,vDim, vNiveau6, 'Lib' | '_' | vHierarchyName );

AttrPutS(vCodeLib6,vDim, vNiveau6, 'Code-Libelle' );
AttrPutS(vLib6 | ' (' | vHierarchyName | ')',vDim, vNiveau6, 'Libelle' | '_' | vHierarchyName );
endif;

IF (vNiveau7 @<>'');
AttrPutS(vLib7,vDim, vNiveau7, 'Lib' | '_' | vHierarchyName );

AttrPutS(vCodeLib7,vDim, vNiveau7, 'Code-Libelle' );
AttrPutS(vLib7 | ' (' | vHierarchyName | ')',vDim, vNiveau7, 'Libelle' | '_' | vHierarchyName );
endif;

IF (vNiveau8 @<>'');
AttrPutS(vLib8,vDim, vNiveau8, 'Lib' | '_' | vHierarchyName);

AttrPutS(vCodeLib8,vDim, vNiveau8, 'Code-Libelle' );
AttrPutS(vLib8 | ' (' | vHierarchyName | ')',vDim, vNiveau8, 'Libelle' | '_' | vHierarchyName );
