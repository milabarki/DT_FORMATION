#region Prolog


#SetInputCharacterSet ('TM1CS_UTF8');
vCubeSource = pCubeSource;
vDimHierarchy = pHierarchie;




vDim = 'Z_Tmp_' | vDimHierarchy ;


    
if(DimensionExists( vDim )=0);
    DimensionCreate( vDim);
else;
DimensionDeleteAllElements( vDim );

endif;

#DimensionDeleteAllElements( '}ElementAttributes_' | vDim );




#endregion
#region Metadata


vHierarchyName = ATTRS( vDimHierarchy, Hierarchie,'Nom' );

AttrInsert( vDim, '','Lib' | '_' | vHierarchyName,'S' );
AttrInsert( vDim, '','Code-Libelle', 'A' );
AttrInsert( vDim, '','Libelle' | '_' | vHierarchyName,'A' );

AttrInsert(vDim,'','N00' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N01' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N02' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N03' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N04' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N05' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N06' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N07' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N08' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N09' | '_' | vHierarchyName,'S');
 AttrInsert(vDim,'','N10' | '_' | vHierarchyName,'S');



    #ASCIIOutput( 'Hierarchie.txt',vHierarchyPrec,Hierarchie,numbertostring(check) );





vNiveau0 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N00' );
vNiveau1 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N01' );
vNiveau2 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N02' );
vNiveau3 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N03' );
vNiveau4 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N04' );
vNiveau5 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N05' );
vNiveau6 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N06' );
vNiveau7 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N07' );
vNiveau8 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N08' );
vNiveau9 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N09' );
vNiveau10 = CellGetS( vCubeSource,Hierarchie,Item,'CODE_N10' );

vPond0 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N00' );
vPond1 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N01' );
vPond2 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N02' );
vPond3 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N03' );
vPond4 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N04' );
vPond5 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N05' );
vPond6 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N06' );
vPond7 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N07' );
vPond8 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N08' );
vPond9 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N09' );
vPond10 = CellGetN( vCubeSource,Hierarchie,Item,'POND_N10' );
   


IF (vNiveau0 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau0,'n');
      DimensionElementInsertDirect(vDim,'',Hierarchie,'n');
      DimensionElementComponentAddDirect( vDim,Hierarchie,vNiveau0,VPOND0);   
      vParent = vNiveau0;
Endif;

IF (vNiveau1 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau1,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau1,VPOND1);   
      vParent = vNiveau1;
endif;
endif;

IF (vNiveau2 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau2,'n');
    IF(vParent @<>'');
    DimensionElementComponentAddDirect( vDim,vParent,vNiveau2,VPOND2);   
      vParent = vNiveau2;
endif;
endif;

IF (vNiveau3 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau3,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau3,VPOND3);   
      vParent = vNiveau3;
endif;
endif;

IF (vNiveau4 @<>'');
      DimensionElementInsertDirect(vDim,'',vNiveau4,'n');
    IF(vParent @<>'');
      DimensionElementComponentAddDirect( vDim,vParent,vNiveau4,VPOND4);   
      vParent = vNiveau4;
endif;
