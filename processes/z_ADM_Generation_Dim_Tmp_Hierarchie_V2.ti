AttrPutS(vLib1,vDim, vNiveau1, 'Lib' | '_' | vHierarchyName);


AttrPutS(vCodeLib1,vDim, vNiveau1, 'Code-Libelle' );
AttrPutS(vLib1 | ' (' | vHierarchyName | ')',vDim, vNiveau1, 'Libelle' | '_' | vHierarchyName );
