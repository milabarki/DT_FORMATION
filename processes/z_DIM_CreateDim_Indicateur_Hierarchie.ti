#region Prolog

vDim = 'Indicateur_Hierarchie';

DimensionDeleteAllElements( vDim );


i = 0;

while ( i <=10);

    Code = NumberToString( i );
    
if(i<10);
            DimensionElementInsert( vDim, '', 'CODE_N0' | Code,'S' );
            DimensionElementInsert( vDim, '', 'LIB_N0' | Code,'S' );
            DimensionElementInsert( vDim, '', 'POND_N0' | Code,'N' );
else;
            DimensionElementInsert( vDim, '', 'CODE_N' | Code,'S' );
            DimensionElementInsert( vDim, '', 'LIB_N' | Code,'S' );
            DimensionElementInsert( vDim, '', 'POND_N' | Code,'N' );


endif;

 i = i +1;
    

end;





#endregion
#region Epilog


#endregion