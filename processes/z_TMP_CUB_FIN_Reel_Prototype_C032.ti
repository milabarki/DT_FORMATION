vConso = 'Total_Compte';

DimensionElementInsert( 'Compte', '', Compte, 'N' );
DimensionElementInsert( 'Compte', '', vConso, 'N' );
DimensionElementInsert( 'Compte', '', 'Bilan', 'N' );
DimensionElementInsert( 'Compte', '', 'CR', 'N' );

DimensionElementComponentAdd( 'Compte', vConso, 'Bilan', 1 );
DimensionElementComponentAdd( 'Compte', vConso, 'CR', 1 );



    
if(Compte @='');
DimensionElementInsert( 'Compte', '', 'Pas_de_Compte', 'N' );
DimensionElementComponentAdd( 'Compte', 'Total_Compte', 'Pas_de_Compte', 1 );
endif;





#endregion
#region Data



Periode = Mois;
vAnnee = SUBST( Periode, 7,4);
vMois = subst(Periode,4,2);
vAnneeCumul = vAnnee;
vPeriode =   vAnnee |'.' |vMois ;



if(CP@='');
    CP='Pas_de_Centre_Proft';
endif;

if(Compte@='');
    Compte='Pas_de_Compte';
endif;

CellIncrementN( m*-1,'FIN_Reel_Prototype', 'R_SAP', VPeriode, CP, Compte, 'M' );



AttrPuts('X','Compte',Compte,'Check_Compte');


