#region Prolog



#endregion
#region Metadata

if(Attrs('Compte',Compte,'Check_Compte')@='X');

if(subst(Compte,1,1)@<'6');
    vConso = 'Bilan';
else;
    vConso = 'CR';
endif;

DimensionElementComponentAdd( 'Compte', vConso, Compte, 1 );
endif;

#endregion
#region Data


CellPutS( COMPTE_CRF, 'FIN_Param_Compte', Compte, 'Hierarchie01','Mapping' );


#endregion